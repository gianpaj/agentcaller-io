# Dashboard, authentication, and call history. Use the Supabase project below;
# Vercel serverless deployments should use its transaction pooler on port 6543.
# The Vercel Supabase integration's POSTGRES_URL and NEXT_PUBLIC_SUPABASE_*
# names are also accepted.
DATABASE_URL=postgresql://postgres.project-ref:password@pooler.example.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Remote MCP and OAuth consent. Requires a verified resource-bound issuer setup.
# Tool access does not enable paid calls. No additional browser origins by default.
MCP_ENABLED=false
MCP_ALLOWED_ORIGINS=

# Saved-card billing server boundary. Enrollment and collection remain unavailable.
# Keep new paid calling disabled while implementing the remaining billing flow.
STRIPE_BILLING_ENABLED=false
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace_with_endpoint_signing_secret
BILLING_SETUP_TOKEN_SECRET=replace-with-an-independent-32-byte-minimum-secret

# Public API authentication.
API_KEY_PEPPER=replace-with-a-32-character-minimum-secret

# Voice-worker callbacks and scheduled jobs.
AGENT_CALLBACK_SECRET=replace-with-a-32-character-minimum-secret
CRON_SECRET=replace-with-a-32-character-minimum-secret

# Optional for operator-only deployments; required for paid tasks.
CDP_API_KEY=cdp_api_key
X402_PAY_TO=0x0000000000000000000000000000000000000000
X402_USDC_ASSET=0x0000000000000000000000000000000000000000

# Required when the platform dispatches or tears down LiveKit rooms.
LIVEKIT_URL=wss://project.livekit.cloud
LIVEKIT_API_KEY=livekit_api_key
LIVEKIT_API_SECRET=livekit_api_secret
LIVEKIT_AGENT_EU=agentcaller-eu
LIVEKIT_AGENT_US=agentcaller-us

# Required only for recording access. connect_me keeps recording disabled.
R2_ACCOUNT_ID=cloudflare_account_id
R2_ACCESS_KEY_ID=r2_access_key
R2_SECRET_ACCESS_KEY=r2_secret
R2_BUCKET=agentcaller-recordings

# Operator-funded connect_me testing. Keep disabled until you intend to place calls.
CONNECT_OPERATOR_CALLS_ENABLED=false
CONNECT_OPERATOR_MAX_USD=5
