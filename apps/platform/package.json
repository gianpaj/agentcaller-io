{
  "name": "@agentcaller/platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc",
    "test": "vitest run",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt --write . && pnpm format:markdown",
    "format:markdown": "prettier --no-error-on-unmatched-pattern --write \"**/*.{md,mdx}\"",
    "format:check": "oxfmt --check . && prettier --no-error-on-unmatched-pattern --check \"**/*.{md,mdx}\""
  },
  "dependencies": {
    "@agentcaller/contracts": "workspace:*",
    "@agentcaller/database": "workspace:*",
    "@aws-sdk/client-s3": "3.1083.0",
    "@aws-sdk/s3-request-presigner": "3.1083.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.97.0",
    "drizzle-orm": "^0.45.2",
    "jose": "6.2.12",
    "livekit-server-sdk": "2.19.1",
    "lucide-react": "^1.14.0",
    "next": "^16.3.3",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "23.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "oxfmt": "0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "tailwindcss": "^4.1.14",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  }
}
