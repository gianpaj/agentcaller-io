LIVEKIT_URL=wss://project.livekit.cloud
LIVEKIT_API_KEY=livekit_api_key
LIVEKIT_API_SECRET=livekit_api_secret
LIVEKIT_AGENT_NAME=agentcaller-eu
PLATFORM_URL=https://agentcaller.io
AGENT_CALLBACK_SECRET=replace-with-a-32-character-minimum-secret
# Authenticated, pre-provisioned outbound trunks. Do not provision from the worker.
LIVEKIT_SIP_TRUNK_EU=ST_eu
LIVEKIT_SIP_TRUNK_US=ST_us
LIVEKIT_CALLER_ID_EU=+34910000000
LIVEKIT_CALLER_ID_US=+12125550000
# Authorized caller IDs, independently chosen for each destination/leg.
# Same-country IDs require Telnyx Local Calling on that number.
CONNECT_CALLER_ID_ES=+34910000000
CONNECT_CALLER_ID_IT=+39060000000
CONNECT_CALLBACK_CALLER_ID=+34910000000
